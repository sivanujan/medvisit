APP_NAME=MedVisit
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://medvisit.localhost:8000
MEDVISIT_BASE_DOMAIN=medvisit.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=medvisit_test
DB_USERNAME=medvisit_ci
DB_PASSWORD=ci_password

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@medvisit.lk"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phone Number Verification & OTP Providers (Faked/Disabled in tests)
OTP_CHANNELS=whatsapp,textlk
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_SEND_CONFIRMATION=false

# MedVisit Public Contact Numbers (Single Source of Truth)
MEDVISIT_WHATSAPP_NUMBER=0755745341
MEDVISIT_PHONE_NUMBER=0701291688

# Clinic Subscription & Payments.lk (Hosted Checkout - Faked in tests)
PAYMENTSLK_MODE=sandbox
PAYMENTSLK_SECRET_KEY=
PAYMENTSLK_MERCHANT_ID=
PAYMENTSLK_WEBHOOK_SECRET=
PAYMENTSLK_RETURN_BASE_URL=
MEDVISIT_TRIAL_DAYS=0
MEDVISIT_GRACE_DAYS=3

REVERB_APP_ID=test-reverb-app-id
REVERB_APP_KEY=test-reverb-app-key
REVERB_APP_SECRET=test-reverb-app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Cloudflare Turnstile Testing Keys (Always pass in tests)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"

# AI Chat & Telegram Bot (Faked in tests)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Feature Flags (Safe defaults for testing)
PLAN_GATING_ENABLED=false
REFERRALS_ENABLED=false
OFFLINE_ENABLED=false
DEV_QUICK_LOGIN=false

# Headless Chrome path for Browsershot PDF rendering on Ubuntu CI
CHROME_PATH=/usr/bin/google-chrome
LARAVEL_PDF_CHROME_PATH=/usr/bin/google-chrome
BROWSERSHOT_TIMEOUT=90
