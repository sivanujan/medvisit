APP_NAME=MedVisit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://medvisit.localhost:8000
MEDVISIT_BASE_DOMAIN=medvisit.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=medvisit
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@medvisit.lk"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_VERIFY_ADDRESS=verify@medvisit.lk
MAIL_NOTIFICATIONS_ADDRESS=notifications@medvisit.lk
MAIL_HELLO_ADDRESS=hello@medvisit.lk
MAIL_REPLY_TO_ADDRESS=support@medvisit.lk
MAIL_LOGO_URL=https://medvisit.lk/images/medvisit-logo.png
MAIL_ICON_URL=https://medvisit.lk/images/medvisit-icon.png

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phone Number Verification & OTP Providers
OTP_CHANNELS=whatsapp,textlk
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_SEND_CONFIRMATION=false

# Clinic Subscription & Payments.lk (Hosted Checkout)
PAYMENTSLK_MODE=sandbox
PAYMENTSLK_SECRET_KEY=
PAYMENTSLK_MERCHANT_ID=
PAYMENTSLK_WEBHOOK_SECRET=
PAYMENTSLK_RETURN_BASE_URL=
MEDVISIT_TRIAL_DAYS=0
MEDVISIT_PLAN_PRICE_CENTS=500000
MEDVISIT_GRACE_DAYS=3

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=
REVERB_SCHEME=
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY="${TURNSTILE_SITE_KEY}"

# Support Chat AI & Owner Notifications
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
